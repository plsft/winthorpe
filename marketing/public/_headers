# Cloudflare Pages headers — applied per-route from longest to shortest match.

# Static asset bundles fingerprinted by Vite — cache hard.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Long-cache the favicon and hero screenshot. They're rarely re-versioned.
/favicon.svg
  Cache-Control: public, max-age=604800
/hero-screenshot.png
  Cache-Control: public, max-age=604800

# HTML pages — short cache, re-validate on each load so we can ship fixes fast.
/*
  Cache-Control: public, max-age=300, must-revalidate
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
