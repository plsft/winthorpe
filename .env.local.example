# Local development overrides. Copy to .env.local (no .example suffix) and
# fill in your actual values. .env.local is gitignored so secrets stay local.
#
# Build picks this up via src-tauri/build.rs after `bun run dev:win` /
# `bun run build`.

# Your plsft GitHub OAuth App's client ID.
# Setup: github.com/organizations/plsft/settings/applications → New OAuth App
# → Enable "Device Flow" in the app settings after creation.
WINTHORPE_GITHUB_CLIENT_ID=PASTE_YOUR_PLSFT_CLIENT_ID_HERE

# Updater endpoint — only override if you publish releases to a different repo.
WINTHORPE_UPDATER_ENDPOINTS=https://github.com/plsft/winthorpe/releases/latest/download/latest.json

# Updater public key — generate via `bun x @tauri-apps/cli signer generate -p ""`
# and paste the public key here. Used to verify downloaded MSI/NSIS bundles.
WINTHORPE_UPDATER_PUBKEY=your_tauri_updater_public_key
