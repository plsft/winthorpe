{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Winthorpe",
	"version": "0.6.3",
	"identifier": "com.plsft.winthorpe",
	"build": {
		"beforeDevCommand": "bun x vite",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "node scripts/prepare-sidecar.mjs && bun run build",
		"frontendDist": "../dist"
	},
	"plugins": {
		"deep-link": {
			"desktop": {
				"schemes": ["winthorpe", "winthorpe-dev"]
			}
		}
	},
	"app": {
		"windows": [
			{
				"title": "Winthorpe",
				"width": 1300,
				"height": 810,
				"minWidth": 900,
				"minHeight": 600,
				"hiddenTitle": true,
				"center": true,
				"backgroundColor": "#0E0E0E",
				"transparent": true,
				"decorations": false,
				"shadow": true,
				"windowEffects": {
					"effects": ["mica"],
					"state": "active",
					"radius": 8
				}
			}
		],
		"security": {
			"csp": null,
			"assetProtocol": {
				"enable": true,
				"scope": {
					"allow": ["**"]
				}
			}
		}
	},
	"bundle": {
		"active": true,
		"createUpdaterArtifacts": false,
		"targets": ["app", "dmg", "nsis", "msi", "appimage"],
		"externalBin": [
			"../sidecar/dist/winthorpe-sidecar",
			"./target/bundled/winthorpe-cli"
		],
		"resources": {
			"../sidecar/dist/vendor/": "vendor"
		},
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"macOS": {
			"entitlements": "Entitlements.plist"
		},
		"windows": {
			"nsis": {
				"installerIcon": "icons/icon.ico",
				"installMode": "currentUser",
				"languages": ["English"]
			},
			"webviewInstallMode": {
				"type": "downloadBootstrapper",
				"silent": true
			}
		}
	}
}
